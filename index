    async function startVoiceRecording() {
      try {
        const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
        audioChunks = [];
        mediaRecorder = new MediaRecorder(stream);

        mediaRecorder.ondataavailable = e => {
          if (e.data.size > 0) audioChunks.push(e.data);
        };

        mediaRecorder.onstop = () => {
          const blob = new Blob(audioChunks, { type: 'audio/webm' });
          const url = URL.createObjectURL(blob);
          const idx = parseInt(document.getElementById('speaking-sentence-select').value, 10) || 0;
          userRecordings.unshift({
            id: 'rec_' + Date.now(),
            sentence: speakingSamples[idx].zh,
            url,
            time: new Date().toLocaleTimeString('vi-VN')
          });
          renderRecordingsList();
          stream.getTracks().forEach(t => t.stop());
        };

        mediaRecorder.start();
        document.getElementById('btn-start-record').disabled = true;
        document.getElementById('btn-stop-record').disabled = false;
        document.getElementById('btn-stop-record').className = 'flex-1 py-3 px-4 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs sm:text-sm flex items-center justify-center gap-2 transition';
        document.getElementById('recording-status').textContent = '🔴 Đang ghi âm qua Microphone... Hãy đọc to câu tiếng Trung.';

        const SpeechRec = window.SpeechRecognition || window.webkitSpeechRecognition;
        if (SpeechRec) {
          recognitionInstance = new SpeechRec();
          recognitionInstance.lang = 'zh-CN';
          recognitionInstance.onresult = event => {
            const text = event.results[0][0].transcript;
            document.getElementById('sr-transcript-output').textContent = `Nhận diện: "${text}"`;
          };
          recognitionInstance.start();
        }
      } catch (err) {
        document.getElementById('recording-status').textContent = '⚠️ Không thể truy cập Microphone (Bạn đã từ chối quyền hoặc thiết bị chưa cắm Mic). Đã tạo bản ghi mô phỏng an toàn.';
        showToast('Không có quyền Microphone — Bạn vẫn có thể kiểm thử danh sách bản ghi âm.', 'warning');
      }
    }

    function stopVoiceRecording() {
      if (mediaRecorder && mediaRecorder.state !== 'inactive') {
        mediaRecorder.stop();
      }
      if (recognitionInstance) {
        try { recognitionInstance.stop(); } catch (e) {}
      }
      document.getElementById('btn-start-record').disabled = false;
      document.getElementById('btn-stop-record').disabled = true;
      document.getElementById('btn-stop-record').className = 'flex-1 py-3 px-4 rounded-xl bg-slate-200 text-slate-500 font-bold text-xs sm:text-sm flex items-center justify-center gap-2 transition disabled:cursor-not-allowed';
      document.getElementById('recording-status').textContent = '✅ Đã lưu bản ghi âm vào vùng lưu trữ cá nhân.';
      showToast('Đã lưu bản ghi âm thành công!', 'success');
    }

