          `}

          <div id="quiz_feedback_${q.id}" class="hidden text-xs p-3 rounded-xl"></div>
        </div>
      `).join('');
    }

    function submitQuizEngine() {
      let correctCount = 0;

      QUIZ_QUESTIONS.forEach(q => {
        const fb = document.getElementById(`quiz_feedback_${q.id}`);
        const key = SERVER_QUIZ_ANSWERS[q.id];
        let userAns = '';

        if (q.options) {
          const checked = document.querySelector(`input[name="quiz_${q.id}"]:checked`);
          userAns = checked ? checked.value : '';
        } else {
          userAns = (document.getElementById(`quiz_input_${q.id}`)?.value || '').trim();
        }

        let isRight = false;
        if (q.type === 'multiple_choice' || q.type === 'true_false' || q.type === 'matching') {
          isRight = userAns === key.correct;
        } else if (q.type === 'fill_blank' || q.type === 'ordering') {
          const clean = userAns.replace(/\s+/g, '').toLowerCase();
          isRight = key.validList.some(v => v.replace(/\s+/g, '').toLowerCase() === clean);
        } else if (q.type === 'pinyin_typing') {
          isRight = key.validPinyin.some(v => normalizePinyin(v) === normalizePinyin(userAns));
        } else if (q.type === 'translate') {
          const lower = userAns.toLowerCase();
          isRight = lower.includes('là') && (lower.includes('giáo viên') || lower.includes('cô giáo') || lower.includes('thầy'));
        }

        if (isRight) correctCount++;

        fb.classList.remove('hidden');
        fb.className = isRight
          ? 'text-xs p-3 rounded-xl bg-emerald-50 text-emerald-800 border border-emerald-200 font-medium'
          : 'text-xs p-3 rounded-xl bg-rose-50 text-rose-800 border border-rose-200 font-medium';
        fb.innerHTML = `${isRight ? '✅ <strong>Chính xác!</strong>' : '❌ <strong>Chưa đúng.</strong>'} ${key.explain}`;
      });

      document.getElementById('quiz-score-summary').innerHTML = `
        Kết quả chấm từ Server: <span class="text-crimson-600 text-base">${correctCount} / ${QUIZ_QUESTIONS.length}</span> câu đúng (${Math.round((correctCount / QUIZ_QUESTIONS.length) * 100)}%)
      `;
      showToast(`Đã chấm bài Quiz: Đạt ${correctCount}/${QUIZ_QUESTIONS.length} câu!`, 'success');
    }

    function resetQuizEngine() {
      renderQuizEngine();
