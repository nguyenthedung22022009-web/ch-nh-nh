        onCorrectStroke: function(strokeData) {
          document.getElementById('writing-feedback').textContent = `✅ Chính xác nét ${strokeData.strokeNum + 1}! Còn ${strokeData.strokesRemaining} nét nữa.`;
        },
        onComplete: function() {
          const score = Math.max(60, 100 - mistakes * 10);
          writingStats[item.char] = Math.max(writingStats[item.char] || 0, score);
          document.getElementById('char-detail-best').textContent = `${writingStats[item.char]}% chính xác`;
          const totalDone = Object.keys(writingStats).length;
          document.getElementById('writing-total-done').textContent = totalDone;
