      const filtered = vocabularyData.filter(item => {
        const matchTopic = topic === 'ALL' || item.topic === topic;
        const matchQuery = !query ||
          item.hanzi.includes(query) ||
          item.pinyin.toLowerCase().includes(query) ||
          normalizePinyin(item.pinyin).includes(normalizePinyin(query)) ||
          item.meaning_vi.toLowerCase().includes(query);
        return matchTopic && matchQuery;
      });

      if (filtered.length === 0) {
        grid.innerHTML = `
          <div class="col-span-full bg-white p-8 rounded-2xl border border-slate-200 text-center text-slate-500 text-sm">
