-- MIGRATION 0001: HSK-WEB 3.0 SCHEMA, RBAC FUNCTIONS & ROW LEVEL SECURITY (RLS)
-- Thực hiện đúng Prompt 3: Bảo mật tuyệt đối, không lộ đáp án, chống tự nâng quyền
-- ============================================================================

create extension if not exists "pgcrypto";

-- 1. Bảng profiles (Lưu thông tin người dùng & vai trò)
create table public.profiles (
  id uuid primary key references auth.users(id) on delete cascade,
  full_name text not null default 'Học sinh mới',
  role text not null default 'student' check (role in ('student', 'teacher', 'admin')),
  assigned_class_id uuid,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

-- Hàm kiểm tra quyền ở tầng Database
create or replace function public.is_admin()
returns boolean language sql security definer stable as $$
  select exists (
    select 1 from public.profiles where id = auth.uid() and role = 'admin'
  );
$$;

create or replace function public.is_teacher_or_admin()
returns boolean language sql security definer stable as $$
  select exists (
    select 1 from public.profiles where id = auth.uid() and role in ('teacher', 'admin')
  );
$$;

-- 2. Bảng từ vựng (vocabulary)
create table public.vocabulary (
  id uuid primary key default gen_random_uuid(),
  hanzi text not null,
  pinyin text not null,
  meaning_vi text not null,
  word_type text not null,
  hsk_level int not null default 1,
  topic text not null,
  example_zh text,
  example_pinyin text,
  example_vi text,
  audio_url text,
  is_verified boolean not null default false,
  created_at timestamptz not null default now()
);

-- 3. Bảng thẻ ôn tập ngắt quãng SRS (srs_cards)
create table public.srs_cards (
  id uuid primary key default gen_random_uuid(),
  user_id uuid not null references public.profiles(id) on delete cascade,
  vocabulary_id uuid not null references public.vocabulary(id) on delete cascade,
  interval_days int not null default 0,
  ease_factor numeric(4,2) not null default 2.50,
  next_review_at timestamptz not null default now(),
  unique(user_id, vocabulary_id)
);

-- 4. Bảng câu hỏi (questions) - KHÔNG CHỨA ĐÁP ÁN ĐÚNG ĐỂ TRÁNH LỘ Ở CLIENT
create table public.questions (
