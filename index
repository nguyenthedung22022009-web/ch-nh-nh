<body class="min-h-screen flex flex-col bg-slate-50 text-slate-900">

  <!-- TOP BANNER: NHÃN DỮ LIỆU THỬ NGHIỆM & TRÌNH TẢI DỰ ÁN -->
  <div class="bg-slate-900 text-slate-100 text-xs py-2 px-4 border-b border-slate-800">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-2">
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-amber-500/20 text-amber-300 border border-amber-500/30">
          ⚠️ Dữ liệu thử nghiệm
        </span>
        <span class="text-slate-300 hidden sm:inline">
          Nội dung HSK 1 (Định hướng HSK 3.0) cần được giáo viên kiểm duyệt trước khi sử dụng chính thức.
        </span>
      </div>
      <div class="flex items-center gap-3">
        <button onclick="switchTab('export')" class="inline-flex items-center gap-1.5 bg-crimson-600 hover:bg-crimson-500 text-white font-semibold px-3 py-1 rounded-lg shadow-sm transition cursor-pointer">
          <i data-lucide="folder-down" class="w-3.5 h-3.5"></i>
          <span>Tải Thư Mục Dự Án (.ZIP chạy ngay)</span>
        </button>
      </div>
    </div>
  </div>

  <!-- HEADER & ROLE SWITCHER -->
  <header class="sticky top-0 z-30 bg-white/95 backdrop-blur border-b border-slate-200 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 flex items-center justify-between h-16 gap-3">
      <!-- Logo -->
      <div class="flex items-center gap-3 cursor-pointer" onclick="switchTab('home')">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-crimson-600 to-crimson-800 flex items-center justify-center text-white shadow-md">
          <span class="hanzi-font text-xl font-bold">汉</span>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <span class="font-extrabold text-lg tracking-tight text-slate-900">HSK-Web</span>
            <span class="text-[11px] font-bold px-2 py-0.5 rounded bg-crimson-50 text-crimson-700 border border-crimson-200">HSK 3.0</span>
          </div>
          <p class="text-xs text-slate-500 hidden sm:block">Tiếng Trung cho học sinh Việt Nam</p>
        </div>
      </div>

      <!-- Role Simulator (RBAC Check) -->
      <div class="flex items-center gap-2 sm:gap-3">
        <div class="flex items-center bg-slate-100 p-1 rounded-xl border border-slate-200 text-xs">
          <span class="px-2 py-1 text-slate-500 font-medium hidden md:inline">Vai trò (RBAC):</span>
          <button id="role-student" onclick="setRole('student')" class="px-2.5 py-1 rounded-lg font-semibold transition bg-white text-slate-900 shadow-sm">
            👨‍🎓 Học sinh
          </button>
          <button id="role-teacher" onclick="setRole('teacher')" class="px-2.5 py-1 rounded-lg font-semibold transition text-slate-600 hover:text-slate-900">
            👩‍🏫 Giáo viên
          </button>
          <button id="role-admin" onclick="setRole('admin')" class="px-2.5 py-1 rounded-lg font-semibold transition text-slate-600 hover:text-slate-900">
            🛡️ Admin
          </button>
        </div>

        <button onclick="downloadStandaloneZip()" title="Tải ngay gói chạy trực tiếp" class="hidden lg:inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold shadow-sm transition">
          <i data-lucide="download" class="w-4 h-4"></i>
          <span>Tải Web Chạy Ngay (.ZIP)</span>
        </button>
      </div>
    </div>

    <!-- MODULE NAVIGATION BAR -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 overflow-x-auto border-t border-slate-100">
      <nav class="flex items-center space-x-1 py-1.5 text-xs sm:text-sm font-medium whitespace-nowrap" aria-label="Điều hướng chính">
        <button onclick="switchTab('home')" data-tab="home" class="nav-btn px-3 py-2 rounded-lg flex items-center gap-1.5 bg-crimson-50 text-crimson-700 font-semibold">
          <i data-lucide="home" class="w-4 h-4"></i> Trang chủ
        </button>
        <button onclick="switchTab('vocab')" data-tab="vocab" class="nav-btn px-3 py-2 rounded-lg flex items-center gap-1.5 text-slate-600 hover:bg-slate-100">
          <i data-lucide="book-open" class="w-4 h-4"></i> Từ vựng &amp; SRS
        </button>
        <button onclick="switchTab('grammar')" data-tab="grammar" class="nav-btn px-3 py-2 rounded-lg flex items-center gap-1.5 text-slate-600 hover:bg-slate-100">
          <i data-lucide="git-branch" class="w-4 h-4"></i> Ngữ pháp
        </button>
        <button onclick="switchTab('writing')" data-tab="writing" class="nav-btn px-3 py-2 rounded-lg flex items-center gap-1.5 text-slate-600 hover:bg-slate-100">
          <i data-lucide="pen-tool" class="w-4 h-4"></i> Luyện viết
        </button>
        <button onclick="switchTab('listening')" data-tab="listening" class="nav-btn px-3 py-2 rounded-lg flex items-center gap-1.5 text-slate-600 hover:bg-slate-100">
          <i data-lucide="headphones" class="w-4 h-4"></i> Luyện nghe
        </button>
        <button onclick="switchTab('speaking')" data-tab="speaking" class="nav-btn px-3 py-2 rounded-lg flex items-center gap-1.5 text-slate-600 hover:bg-slate-100">
