        onMistake: function(strokeData) {
          mistakes++;
          document.getElementById('writing-feedback').textContent = `❌ Nét thứ ${strokeData.strokeNum + 1} chưa đúng hướng/vị trí. Hãy thử lại! (Lỗi: ${mistakes})`;
