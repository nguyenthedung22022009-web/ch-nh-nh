                  example_zh: { type: "STRING" },
                  example_pinyin: { type: "STRING" },
                  example_vi: { type: "STRING" }
                },
                propertyOrdering: ["hanzi", "pinyin", "meaning_vi", "word_type", "hsk_level", "topic", "example_zh", "example_pinyin", "example_vi"]
              }
            }
          }
        };

        const res = await fetchGeminiWithBackoff(apiUrl, payload);
        const list = JSON.parse(res.candidates[0].content.parts[0].text);
        const header = "hanzi,pinyin,meaning_vi,word_type,hsk_level,topic,example_zh,example_pinyin,example_vi";
        const rows = list.map(item =>
          [item.hanzi, item.pinyin, item.meaning_vi, item.word_type, item.hsk_level, item.topic, item.example_zh, item.example_pinyin, item.example_vi]
            .map(v => String(v).replace(/,/g, ' -'))
            .join(',')
        );
        textarea.value = [header, ...rows].join('\n');
        validateAndPreviewCSV();
        showToast('Đã tạo dữ liệu CSV bằng Gemini AI! Hãy xem trước và nhấn xác nhận nhập.', 'success');
      } catch (e) {
        showToast('Không thể gọi AI tạo CSV lúc này, đã nạp mẫu dự phòng.', 'warning');
        loadValidCSVSample();
      } finally {
        btn.disabled = false;
      }
    }

    // -----------------------------------------------------------------
    // INITIALIZATION ON LOAD
    // -----------------------------------------------------------------</script></body></html>
