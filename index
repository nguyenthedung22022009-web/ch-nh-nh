    function validateAndPreviewCSV() {
      const raw = document.getElementById('csv-raw-input').value.trim();
      const previewEl = document.getElementById('csv-preview-result');
      const commitBtn = document.getElementById('btn-commit-csv');
      stagedCSVRows = [];

      if (!raw) {
        previewEl.innerHTML = '<p class="text-rose-600 font-semibold">Vui lòng dán nội dung CSV trước khi kiểm tra.</p>';
        commitBtn.disabled = true;
        return;
      }

      const lines = raw.split(/\r?\n/).filter(l => l.trim() !== '');
      const requiredCols = ['hanzi','pinyin','meaning_vi','word_type','hsk_level','topic','example_zh','example_pinyin','example_vi'];
      const header = lines[0].split(',').map(s => s.trim());

      const missingCols = requiredCols.filter(c => !header.includes(c));
      if (missingCols.length > 0) {
        previewEl.innerHTML = `<div class="p-3 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 font-semibold">❌ Lỗi cấu trúc cột: Thiếu các cột bắt buộc: ${missingCols.join(', ')}</div>`;
        commitBtn.disabled = true;
        return;
      }

      let hasError = false;
      const reportHTML = [];

      for (let i = 1; i < lines.length; i++) {
        const cols = lines[i].split(',').map(s => s.trim());
        const rowObj = {};
        requiredCols.forEach((colName, idx) => { rowObj[colName] = cols[idx] || ''; });

        const isDuplicate = vocabularyData.some(v => v.hanzi === rowObj.hanzi);
        if (!rowObj.hanzi || !rowObj.pinyin || !rowObj.meaning_vi) {
          hasError = true;
          reportHTML.push(`<div class="p-2.5 rounded-lg bg-rose-50 border border-rose-200 text-rose-800">Dòng ${i + 1}: ❌ Thiếu dữ liệu bắt buộc (hanzi/pinyin/meaning_vi).</div>`);
        } else if (isDuplicate) {
          hasError = true;
          reportHTML.push(`<div class="p-2.5 rounded-lg bg-amber-50 border border-amber-200 text-amber-900">Dòng ${i + 1}: ⚠️ Phát hiện trùng lặp từ "${rowObj.hanzi}" đã có trong hệ thống.</div>`);
        } else {
          stagedCSVRows.push(rowObj);
          reportHTML.push(`<div class="p-2.5 rounded-lg bg-emerald-50 border border-emerald-200 text-emerald-900">Dòng ${i + 1}: ✅ Hợp lệ — <strong class="hanzi-font">${rowObj.hanzi}</strong> (${rowObj.pinyin}) : ${rowObj.meaning_vi} [Gắn nhãn: Chờ kiểm duyệt]</div>`);
        }
      }

      previewEl.innerHTML = reportHTML.join('');
      commitBtn.disabled = hasError || stagedCSVRows.length === 0;
    }

    function commitCSVImport() {
